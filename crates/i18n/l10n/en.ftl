cli-about = Download manager: segmented transfers with resume
tray-open = Open downloads folder
tray-clip = Add from clipboard
tray-quit = Quit
tray-tooltip = Downloader
no-tasks = no tasks
watching = watching the core, Ctrl+C to quit
core-closed = core closed the connection
task-accepted = task { $id } accepted by core: { $url }
task-paused = task { $id } is pausing
task-resumed = task { $id } resumed
task-removed = task { $id } removed from the list
task-removed-file = task { $id } removed together with the file
task-done = task { $id } finished: { $size } — { $path }
task-failed = task { $id } failed: { $message }
need-url = pass a URL, --list, or --clipboard
no-layout = no layout: the task is idle or using a single connection
rate-unsupported = this protocol cannot apply a rate limit
stopped-early = download stopped before completion
motw-fail = could not mark the file as downloaded from the network: { $error }
need-selected = probe returned no selected files
unexpected-core = unexpected response from core
addr = url
size = size
name = name
file = file
files = files
none = none
unknown = unknown
chosen = selected
skip = skip
parts = parts
err-range = server does not support Range: { $url }
err-changed = resource changed during download, resume is impossible: { $url }
err-verify = verification failed for { $path }: expected { $expected }, got { $actual }
err-seg-oob = segment { $id } does not exist, table has { $count }
err-overrun = segment { $id } (range { $start }..{ $end }) tried to write up to { $attempted }
