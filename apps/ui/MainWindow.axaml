<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.Ui.ViewModels"
        xmlns:c="using:Downloader.Ui.Controls"
        xmlns:i18n="using:Downloader.Ui.I18n"
        x:Class="Downloader.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Downloader"
        Width="980" Height="640"
        MinWidth="680" MinHeight="420">

    <Window.Resources>
        <vm:КолірЗвʼязкуКонвертер x:Key="КолірЗвʼязку"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Рядок списку сам малює свої відступи: типовий ListBoxItem
             додає власні, і разом виходить подвійна рамка. -->
        <Style Selector="ListBoxItem" x:DataType="vm:TaskRow">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="IsVisible" Value="{Binding IsVisibleInFilter}"/>
        </Style>

        <!-- Кнопки в рядку: іконка без рамки, доки на неї не наведено. -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Головна дія — Fluent accent, щоб «Завантажити» не губилась
             серед Буфера і Якості. -->
        <Style Selector="Button.primary">
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style Selector="TextBlock.metric">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="TextBlock.host">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="14">

        <!-- ── Додавання ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Text="{Binding NewUrl}"
                     PlaceholderText="{i18n:T ui-paste-url}"
                     IsEnabled="{Binding Connected}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>

            <!-- Показуємо лише коли черг > 1 — інакше сирота-ComboBox. -->
            <ComboBox Grid.Column="1"
                      Margin="8,0,0,0"
                      MinWidth="110"
                      ItemsSource="{Binding QueueNames}"
                      SelectedItem="{Binding SelectedAddQueue}"
                      ToolTip.Tip="{i18n:T ui-add-queue-tip}"
                      IsEnabled="{Binding Connected}"
                      IsVisible="{Binding ShowAddQueuePicker}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <Button Padding="14,0"
                        Content="{i18n:T ui-clipboard}"
                        Command="{Binding PasteAddCommand}"
                        IsEnabled="{Binding Connected}"/>
                <Button Padding="14,0"
                        Content="{i18n:T ui-quality}"
                        ToolTip.Tip="{i18n:T ui-choose-quality}"
                        Command="{Binding ShowQualityCommand}"
                        IsEnabled="{Binding Connected}"/>
                <Button Classes="accent primary"
                        Content="{i18n:T ui-download}"
                        Command="{Binding AddCommand}"
                        IsDefault="True"
                        IsEnabled="{Binding Connected}"/>
            </StackPanel>
        </Grid>

        <!--
            Список замість DataGrid навмисно: DataGrid в Avalonia 12
            переведено в maintenance mode, а тут потрібні лише рядок,
            смужка сегментів і кнопки.
        -->
        <!--
            ── Вибір якості ────────────────────────────────────────────
            З'являється лише на вимогу: проба коштує мережевого звернення,
            а для YouTube — ще й запуску yt-dlp на кілька секунд.
        -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                IsVisible="{Binding QualityOpen}">

            <StackPanel Spacing="8">
                <TextBlock Text="{i18n:T ui-choose-quality}" FontWeight="SemiBold"/>

                <ListBox ItemsSource="{Binding Variants}"
                         SelectedItem="{Binding SelectedVariant}"
                         MaxHeight="190"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VariantRow">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           MinWidth="90"/>
                                <TextBlock Grid.Column="1"
                                           Classes="dim"
                                           Text="{Binding Details}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Padding="14,4"
                            Content="{i18n:T ui-cancel}"
                            Command="{Binding CancelQualityCommand}"/>
                    <Button Classes="accent"
                            Padding="18,4"
                            Content="{i18n:T ui-download}"
                            Command="{Binding AddCommand}"
                            IsEnabled="{Binding Connected}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Створення нової черги ────────────────────────────────── -->
        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="14,12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                IsVisible="{Binding NewQueueOpen}">
            <StackPanel Spacing="8">
                <TextBlock Text="{i18n:T ui-queue-create-title}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{i18n:T ui-queue-name}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewQueueName}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{i18n:T ui-queue-slots}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Width="50" Text="{Binding NewQueueSlotsText}" Margin="0,0,12,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Classes="label" Text="{i18n:T ui-queue-speed}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="0" Grid.Column="5" Width="70" Text="{Binding NewQueueRateText}"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <TextBlock Classes="label" Text="{i18n:T ui-schedule}" VerticalAlignment="Center"/>
                        <TextBox Width="55" PlaceholderText="22:00" Text="{Binding NewQueueScheduleFromText}"/>
                        <TextBlock Classes="label" Text="{i18n:T ui-dash}" VerticalAlignment="Center"/>
                        <TextBox Width="55" PlaceholderText="07:00" Text="{Binding NewQueueScheduleToText}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Padding="14,4" Content="{i18n:T ui-queue-cancel}" Command="{Binding CancelNewQueueCommand}"/>
                        <Button Padding="14,4" Content="{i18n:T ui-queue-save}" Command="{Binding CreateQueueCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── Панель черг: фільтр та керування ──────────────────────── -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Classes="label" Text="{i18n:T ui-queue}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      MinWidth="140"
                      ItemsSource="{Binding QueueFilterOptions}"
                      SelectedItem="{Binding SelectedFilter}"/>
            <Button Grid.Column="2"
                    Classes="icon"
                    Margin="8,0,0,0"
                    Content="⏸"
                    ToolTip.Tip="{i18n:T ui-queue-pause}"
                    Command="{Binding PauseCurrentQueueCommand}"
                    IsVisible="{Binding CanManageCurrentQueue}"/>
            <Button Grid.Column="3"
                    Classes="icon"
                    Margin="4,0,0,0"
                    Content="▶"
                    ToolTip.Tip="{i18n:T ui-queue-resume}"
                    Command="{Binding ResumeCurrentQueueCommand}"
                    IsVisible="{Binding CanManageCurrentQueue}"/>
            <Button Grid.Column="4"
                    Classes="icon"
                    Margin="4,0,0,0"
                    Content="✕"
                    ToolTip.Tip="{i18n:T ui-queue-delete}"
                    Command="{Binding DeleteCurrentQueueCommand}"
                    IsVisible="{Binding CanDeleteCurrentQueue}"/>
            <Button Grid.Column="6"
                    Padding="12,4"
                    Content="{i18n:T ui-queue-add}"
                    Command="{Binding ShowNewQueueCommand}"
                    IsEnabled="{Binding Connected}"/>
        </Grid>

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
          <Panel>
            <!-- Порожній список: повідомлення + CTA в буфер. -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        IsVisible="{Binding !Tasks.Count}">
                <TextBlock Text="{i18n:T ui-empty}"
                           Classes="dim"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420"/>
                <Button Classes="accent"
                        HorizontalAlignment="Center"
                        Padding="18,8"
                        Content="{i18n:T ui-paste-clipboard}"
                        Command="{Binding PasteAddCommand}"
                        IsEnabled="{Binding Connected}"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding Tasks}"
                     SelectedItem="{Binding Selected}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Classes="host"
                                               Text="{Binding Host}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding Host,
                                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </Grid>

                                <!--
                                    Смужка сегментів замість ProgressBar.
                                    Розкладка приходить лише для виділеного
                                    рядка, решта малюється як звичайний
                                    прогрес — за Fraction.
                                -->
                                <c:SegmentBar Height="9"
                                              Margin="0,2,0,0"
                                              Parts="{Binding Parts}"
                                              Total="{Binding Total}"
                                              Fraction="{Binding Fraction}"/>

                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            CornerRadius="3"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Classes="label" Text="{Binding Queue}" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Classes="dim" Text="{Binding Status}" VerticalAlignment="Center"/>
                                    <TextBlock Classes="metric"
                                               Text="{Binding PercentText}"
                                               MinWidth="40"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Classes="metric"
                                               Text="{Binding SpeedText}"
                                               MinWidth="72"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Classes="metric"
                                               Text="{Binding EtaText}"
                                               MinWidth="56"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Classes="dim" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                    <TextBlock Classes="dim" Text="{Binding SegmentsText}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Помилку показуємо цілим текстом: людина має
                                     впізнати проблему, не читаючи журналу. -->
                                <TextBlock Text="{Binding Error}"
                                           IsVisible="{Binding Error,
                                               Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Foreground="IndianRed"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Classes="icon"
                                        Content="⏸"
                                        ToolTip.Tip="{i18n:T ui-pause}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).PauseCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="icon"
                                        Content="▶"
                                        ToolTip.Tip="{i18n:T ui-resume}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ResumeCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="icon"
                                        Content="📂"
                                        ToolTip.Tip="{i18n:T ui-reveal}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="icon"
                                        Content="✕"
                                        ToolTip.Tip="{i18n:T ui-remove}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </Border>

        <!--
            ── Деталі виділеного ───────────────────────────────────────
            Те саме, за чим у IDM відкривають вікно завантаження: форма
            кривої швидкості й живий поділ на частини. Одне число
            «2,4 МБ/с» не відрізняє рівне качання від пилки, що падає до
            нуля щопівсекунди, — а це різні причини.
        -->
        <Border Grid.Row="5"
                Margin="0,12,0,0"
                Padding="14,12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                IsVisible="{Binding Selected,
                    Converter={x:Static ObjectConverters.IsNotNull}}">

            <Grid ColumnDefinitions="*,16,300"
                  DataContext="{Binding Selected}"
                  x:DataType="vm:TaskRow">

                <!-- Ліва половина: розкладка частин -->
                <StackPanel Grid.Column="0" Spacing="7">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Classes="label"
                               Text="{Binding Url}"
                               TextTrimming="CharacterEllipsis"/>

                    <c:SegmentBar Height="22"
                                  Parts="{Binding Parts}"
                                  Total="{Binding Total}"
                                  Fraction="{Binding Fraction}"/>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="{i18n:T ui-queue}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                    CornerRadius="3"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Classes="label" Text="{Binding Queue}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="metric" Text="{Binding PercentText}"/>
                        <TextBlock Classes="dim" Text="{Binding SizeText}"/>
                        <TextBlock Classes="dim" Text="{Binding SegmentsText}"/>
                        <TextBlock Classes="metric" Text="{Binding EtaText}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Classes="label" Text="{i18n:T ui-queue-move}" VerticalAlignment="Center"/>
                            <ComboBox Width="110"
                                      ItemsSource="{Binding $parent[Window].((vm:MainViewModel)DataContext).QueueNames}"
                                      SelectedItem="{Binding $parent[Window].((vm:MainViewModel)DataContext).TargetMoveQueue}"/>
                            <Button Padding="8,2"
                                    Content="→"
                                    ToolTip.Tip="{i18n:T ui-queue-move}"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveSelectedTaskCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Права половина: графік швидкості -->
                <StackPanel Grid.Column="2" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="label"
                                   Text="{i18n:T ui-speed-window}"/>
                        <TextBlock Grid.Column="1"
                                   Classes="label"
                                   Text="{Binding PeakText}"/>
                    </Grid>

                    <Border CornerRadius="4"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            Padding="1">
                        <c:SpeedChart Height="66"
                                      Samples="{Binding SpeedHistory}"
                                      Revision="{Binding SpeedRevision}"/>
                    </Border>

                    <TextBlock Text="{Binding SpeedText}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ── Налаштування (розгортається) ────────────────────────────
            Ліміти, розклад і післядія жили внизу й захаращували смужку
            стану. Тут ті самі прив'язки — лише інше місце.
        -->
        <Border Grid.Row="6"
                Margin="0,12,0,0"
                Padding="14,12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                IsVisible="{Binding SettingsOpen}"
                IsEnabled="{Binding Connected}">
            <StackPanel Spacing="10">
                <TextBlock Text="{i18n:T ui-settings-title}" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="label" Text="{i18n:T ui-concurrent}" VerticalAlignment="Center"/>
                    <TextBox Width="44" Text="{Binding MaxConcurrentText}"/>
                    <TextBlock Classes="label" Text="{i18n:T ui-kbps}" VerticalAlignment="Center"/>
                    <TextBox Width="64" Text="{Binding RateLimitText}"/>
                    <Button Classes="accent"
                            Padding="12,4"
                            Content="{i18n:T ui-apply}"
                            Command="{Binding ApplySettingsCommand}"/>
                </StackPanel>

                <!-- Правила ядра, не вікна: розклад і післядія переживають закриття. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="label" Text="{i18n:T ui-after-queue}" VerticalAlignment="Center"/>
                    <ComboBox Width="128" SelectedIndex="{Binding PostActionIndex}">
                        <ComboBoxItem Content="{i18n:T ui-after-nothing}"/>
                        <ComboBoxItem Content="{i18n:T ui-after-sleep}"/>
                        <ComboBoxItem Content="{i18n:T ui-after-shutdown}"/>
                    </ComboBox>
                    <TextBlock Classes="label" Text="{i18n:T ui-schedule}" VerticalAlignment="Center"/>
                    <TextBox Width="52" PlaceholderText="22:00" Text="{Binding ScheduleFromText}"/>
                    <TextBlock Classes="label" Text="{i18n:T ui-dash}" VerticalAlignment="Center"/>
                    <TextBox Width="52" PlaceholderText="07:00" Text="{Binding ScheduleToText}"/>
                    <TextBlock Classes="label" Text="{i18n:T ui-night-kbps}" VerticalAlignment="Center"/>
                    <TextBox Width="52" Text="{Binding QuietRateText}"/>
                    <TextBox Width="52" PlaceholderText="00:00" Text="{Binding QuietFromText}"/>
                    <TextBlock Classes="label" Text="{i18n:T ui-dash}" VerticalAlignment="Center"/>
                    <TextBox Width="52" PlaceholderText="07:00" Text="{Binding QuietToText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Рядок стану: зв'язок + тема + кнопка налаштувань. -->
        <Grid Grid.Row="7" ColumnDefinitions="*,Auto" Margin="2,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="8" Height="8"
                         VerticalAlignment="Center"
                         Fill="{Binding Connected,
                             Converter={StaticResource КолірЗвʼязку}}"/>
                <TextBlock Classes="dim"
                           Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420"
                           VerticalAlignment="Center"/>
                <!-- Тема не залежить від ядра: вікно може бути темним і без нього. -->
                <ToggleSwitch Margin="16,0,0,0"
                              IsChecked="{Binding DarkTheme}"
                              OnContent="{i18n:T ui-theme-dark}"
                              OffContent="{i18n:T ui-theme-light}"
                              VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Padding="12,4"
                    Content="{i18n:T ui-settings}"
                    ToolTip.Tip="{i18n:T ui-settings-tip}"
                    Command="{Binding ToggleSettingsCommand}"/>
        </Grid>
    </Grid>
</Window>
