<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Downloader.Ui.ViewModels"
        xmlns:c="using:Downloader.Ui.Controls"
        xmlns:i18n="using:Downloader.Ui.I18n"
        x:Class="Downloader.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Downloader"
        Width="980" Height="640"
        MinWidth="680" MinHeight="420">

    <Window.Resources>
        <vm:КолірЗвʼязкуКонвертер x:Key="КолірЗвʼязку"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Рядок списку сам малює свої відступи: типовий ListBoxItem
             додає власні, і разом виходить подвійна рамка. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <!-- Кнопки в рядку: іконка без рамки, доки на неї не наведено. -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="14">

        <!-- ── Додавання ─────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Text="{Binding NewUrl}"
                     PlaceholderText="{i18n:T ui-paste-url}"
                     IsEnabled="{Binding Connected}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddCommand}"/>
                </TextBox.KeyBindings>
            </TextBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <Button Padding="14,0"
                        Content="{i18n:T ui-clipboard}"
                        Command="{Binding PasteAddCommand}"
                        IsEnabled="{Binding Connected}"/>
                <Button Padding="14,0"
                        Content="{i18n:T ui-quality}"
                        ToolTip.Tip="{i18n:T ui-choose-quality}"
                        Command="{Binding ShowQualityCommand}"
                        IsEnabled="{Binding Connected}"/>
                <Button Padding="18,0"
                        Content="{i18n:T ui-download}"
                        Command="{Binding AddCommand}"
                        IsDefault="True"
                        IsEnabled="{Binding Connected}"/>
            </StackPanel>
        </Grid>

        <!--
            Список замість DataGrid навмисно: DataGrid в Avalonia 12
            переведено в maintenance mode, а тут потрібні лише рядок,
            смужка сегментів і кнопки.
        -->
        <!--
            ── Вибір якості ────────────────────────────────────────────
            З'являється лише на вимогу: проба коштує мережевого звернення,
            а для YouTube — ще й запуску yt-dlp на кілька секунд.
        -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                IsVisible="{Binding QualityOpen}">

            <StackPanel Spacing="8">
                <TextBlock Text="{i18n:T ui-choose-quality}" FontWeight="SemiBold"/>

                <ListBox ItemsSource="{Binding Variants}"
                         SelectedItem="{Binding SelectedVariant}"
                         MaxHeight="190"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VariantRow">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           MinWidth="90"/>
                                <TextBlock Grid.Column="1"
                                           Classes="dim"
                                           Text="{Binding Details}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Padding="14,4"
                            Content="{i18n:T ui-cancel}"
                            Command="{Binding CancelQualityCommand}"/>
                    <Button Padding="18,4"
                            Content="{i18n:T ui-download}"
                            Command="{Binding AddCommand}"
                            IsEnabled="{Binding Connected}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
          <Panel>
            <!-- Порожній список має щось казати. Порожня рамка виглядає як
                 несправність, а не як «ще нічого не додано». -->
            <TextBlock Text="{i18n:T ui-empty}"
                       Classes="dim"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !Tasks.Count}"/>

            <ListBox ItemsSource="{Binding Tasks}"
                     SelectedItem="{Binding Selected}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="5">

                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>

                                <!--
                                    Смужка сегментів замість ProgressBar.
                                    Розкладка приходить лише для виділеного
                                    рядка, решта малюється як звичайний
                                    прогрес — за Fraction.
                                -->
                                <c:SegmentBar Height="8"
                                              Parts="{Binding Parts}"
                                              Total="{Binding Total}"
                                              Fraction="{Binding Fraction}"/>

                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Classes="dim" Text="{Binding Status}"/>
                                    <TextBlock Classes="dim" Text="{Binding SizeText}"/>
                                    <TextBlock Classes="dim" Text="{Binding SpeedText}"/>
                                    <TextBlock Classes="dim" Text="{Binding EtaText}"/>
                                    <TextBlock Classes="dim" Text="{Binding SegmentsText}"/>
                                </StackPanel>

                                <!-- Помилку показуємо цілим текстом: людина має
                                     впізнати проблему, не читаючи журналу. -->
                                <TextBlock Text="{Binding Error}"
                                           IsVisible="{Binding Error,
                                               Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Foreground="IndianRed"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Classes="icon"
                                        Content="⏸"
                                        ToolTip.Tip="{i18n:T ui-pause}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).PauseCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="icon"
                                        Content="▶"
                                        ToolTip.Tip="{i18n:T ui-resume}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ResumeCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="icon"
                                        Content="📂"
                                        ToolTip.Tip="{i18n:T ui-reveal}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Classes="icon"
                                        Content="✕"
                                        ToolTip.Tip="{i18n:T ui-remove}"
                                        Command="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </Border>

        <!--
            ── Деталі виділеного ───────────────────────────────────────
            Те саме, за чим у IDM відкривають вікно завантаження: форма
            кривої швидкості й живий поділ на частини. Одне число
            «2,4 МБ/с» не відрізняє рівне качання від пилки, що падає до
            нуля щопівсекунди, — а це різні причини.
        -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="14,12"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                IsVisible="{Binding Selected,
                    Converter={x:Static ObjectConverters.IsNotNull}}">

            <Grid ColumnDefinitions="*,16,300"
                  DataContext="{Binding Selected}"
                  x:DataType="vm:TaskRow">

                <!-- Ліва половина: розкладка частин -->
                <StackPanel Grid.Column="0" Spacing="7">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Classes="label"
                               Text="{Binding Url}"
                               TextTrimming="CharacterEllipsis"/>

                    <c:SegmentBar Height="22"
                                  Parts="{Binding Parts}"
                                  Total="{Binding Total}"
                                  Fraction="{Binding Fraction}"/>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Classes="dim" Text="{Binding SizeText}"/>
                        <TextBlock Classes="dim" Text="{Binding SegmentsText}"/>
                        <TextBlock Classes="dim" Text="{Binding EtaText}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Права половина: графік швидкості -->
                <StackPanel Grid.Column="2" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="label"
                                   Text="{i18n:T ui-speed-window}"/>
                        <TextBlock Grid.Column="1"
                                   Classes="label"
                                   Text="{Binding PeakText}"/>
                    </Grid>

                    <Border CornerRadius="4"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            Padding="1">
                        <c:SpeedChart Height="66"
                                      Samples="{Binding SpeedHistory}"
                                      Revision="{Binding SpeedRevision}"/>
                    </Border>

                    <TextBlock Text="{Binding SpeedText}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рядок стану: кружечок зв'язку плюс останнє повідомлення. Без
             кружечка «з'єднано з ядром» губиться серед інших текстів, а це
             найважливіше, що тут є: без ядра не працює нічого. -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="2,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="8" Height="8"
                         VerticalAlignment="Center"
                         Fill="{Binding Connected,
                             Converter={StaticResource КолірЗвʼязку}}"/>
                <TextBlock Classes="dim"
                           Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Тема не залежить від ядра: вікно може бути темним і без нього. -->
                <ToggleSwitch Margin="16,0,0,0"
                              IsChecked="{Binding DarkTheme}"
                              OnContent="{i18n:T ui-theme-dark}"
                              OffContent="{i18n:T ui-theme-light}"
                              VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        IsEnabled="{Binding Connected}">
                <TextBlock Classes="label" Text="{i18n:T ui-concurrent}" VerticalAlignment="Center"/>
                <TextBox Width="44" Text="{Binding MaxConcurrentText}"/>
                <TextBlock Classes="label" Text="{i18n:T ui-kbps}" VerticalAlignment="Center"/>
                <TextBox Width="64" Text="{Binding RateLimitText}"/>
                <Button Padding="12,4" Content="{i18n:T ui-apply}" Command="{Binding ApplySettingsCommand}"/>
            </StackPanel>

            <!-- Правила ядра, не вікна: розклад і післядія переживають закриття. -->
            <StackPanel Grid.Row="1" Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,6,0,0"
                        IsEnabled="{Binding Connected}">
                <TextBlock Classes="label" Text="{i18n:T ui-after-queue}" VerticalAlignment="Center"/>
                <ComboBox Width="128" SelectedIndex="{Binding PostActionIndex}">
                    <ComboBoxItem Content="{i18n:T ui-after-nothing}"/>
                    <ComboBoxItem Content="{i18n:T ui-after-sleep}"/>
                    <ComboBoxItem Content="{i18n:T ui-after-shutdown}"/>
                </ComboBox>
                <TextBlock Classes="label" Text="{i18n:T ui-schedule}" VerticalAlignment="Center"/>
                <TextBox Width="52" PlaceholderText="22:00" Text="{Binding ScheduleFromText}"/>
                <TextBlock Classes="label" Text="{i18n:T ui-dash}" VerticalAlignment="Center"/>
                <TextBox Width="52" PlaceholderText="07:00" Text="{Binding ScheduleToText}"/>
                <TextBlock Classes="label" Text="{i18n:T ui-night-kbps}" VerticalAlignment="Center"/>
                <TextBox Width="52" Text="{Binding QuietRateText}"/>
                <TextBox Width="52" PlaceholderText="00:00" Text="{Binding QuietFromText}"/>
                <TextBlock Classes="label" Text="{i18n:T ui-dash}" VerticalAlignment="Center"/>
                <TextBox Width="52" PlaceholderText="07:00" Text="{Binding QuietToText}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
