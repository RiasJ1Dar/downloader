{
  "manifest_version": 3,
  "default_locale": "uk",
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "cookies", "webRequest", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
