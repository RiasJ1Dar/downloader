/target
**/*.rs.bk
*.pdb

# стан і бази під час розробки
*.db
*.db-shm
*.db-wal
/testdata

# сторонні бінарники (ffmpeg кладеться в інсталятор, yt-dlp качається)
/vendor
# ⚠️ Уся тека, а не лише *.exe: ffmpeg приходить із вісьмома DLL на 147 МБ,
# і правило на розширення їх не ловить — один `git add -A` і вони в історії
# назавжди. Ці інструменти качаються (`dl ffmpeg-install`, yt-dlp -U), тож
# у репозиторії їм місця немає.
/tools/

# Нотатки й плани лежать поза репозиторієм. Тут — лише README.
*.md
!README.md
!README.*.md

# .NET: збірки вікна
bin/
obj/

# знімки Archify visual-check — не в git
docs/*.visual-check*
docs/*.vcheck-out.txt

# ⚠️ Приватний ключ розширення. Ним підписується CRX, а Extension ID з нього
# стоїть в allowed_origins native host — хто має ключ, той підпише підробку,
# яку nmhost прийме за свою. Репозиторій публічний: ключу тут місця немає.
*.pem
# Зібране розширення — артефакт, а не джерело.
ext/*.crx

# Зібране розширення — артефакт збірки
ext/dist/
