  "cards": [
    {
      "dot": "cyan",
      "title": "Clients",
      "items": [
        "Window, CLI and browser are equals: one protocol, no shortcuts",
        "The channel is local only: a named pipe, never TCP on 127.0.0.1"
      ]
    },
    {
      "dot": "emerald",
      "title": "Core",
      "items": [
        "A separate process in the tray: close the window, the download stays",
        "Speed and ETA are computed here — otherwise clients would show different numbers"
      ]
    },
    {
      "dot": "rose",
      "title": "Modules",
      "items": [
        "The core asks the registry «who takes this link» instead of calling HTTP itself",
        "The human picks the quality: HLS and DASH list it from the manifest, YouTube from its formats",
        "A torrent module drops in — the contract already allows for it"
      ]
    }
  ]
